# ── 의존성 (npm install 로 다시 받을 수 있음) ──
node_modules/

# ── 빌드 결과물 (npm run build / Vercel 이 다시 만듦) ──
dist/
dist-ssr/
*.local

# ── 환경변수 · 비밀 키 (절대 업로드 금지) ──
# .env.local 에 Supabase URL·키가 들어갑니다. 예시 파일만 올립니다.
.env
.env.*
!.env.example

# ── 배포 · DB 도구가 만드는 로컬 설정 ──
.vercel/
supabase/.temp/
supabase/.branches/

# ── 로그 ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 편집기 · AI 도구 개인 설정 ──
.vscode/
.idea/
.claude/
*.swp

# ── 운영체제 자동 생성 파일 (Windows · macOS · OneDrive) ──
.DS_Store
Thumbs.db
desktop.ini
~$*
